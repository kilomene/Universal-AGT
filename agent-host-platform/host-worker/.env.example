# Universal AGT host worker — example configuration.
# Copy to /opt/agent-host/config/worker.env (installer does this for you)
# and fill in the real values. NEVER commit the real file.
#
# The installer accepts these same variables as UAHT_*-prefixed environment
# variables, e.g. UAHT_CONTROL_PLANE_URL, UAHT_HOST_NAME.

# Base URL of the control plane (https in production).
WORKER_CONTROL_PLANE_URL=https://control-plane.example.com

# Abstract host name, e.g. persistent-host-01. Never an IP address.
WORKER_HOST_NAME=persistent-host-01

# Host bearer token (shown once at registration; installer can provision it).
WORKER_HOST_TOKEN=

# Host UUID returned by POST /v1/hosts/register (provisioned by installer).
WORKER_HOST_ID=

# Long-poll window for task claims, seconds (protocol max 30).
WORKER_POLL_WAIT=25

# Heartbeat cadence, seconds (minimum 5).
WORKER_HEARTBEAT_INTERVAL=30

# Local state, logs, deployments.
WORKER_WORK_DIR=/opt/agent-host

# Where downloaded artifacts / app files land.
WORKER_APPS_DIR=/srv/agent-apps

# Advertised worker version (checked against heartbeat worker_update).
WORKER_WORKER_VERSION=0.1.0

# Optional explicit capabilities (comma-separated). Empty = auto-detect
# from the docker binary (docker, docker-compose).
WORKER_CAPABILITIES=
