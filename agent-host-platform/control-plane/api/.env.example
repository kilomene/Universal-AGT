# --- Database ---------------------------------------------------------------
# Postgres connection string. Works with local Postgres or Supabase
# (use the Supabase "connection string" / transaction pooler URI).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/universal_agt

# --- Server -----------------------------------------------------------------
PORT=3000

# --- Storage ----------------------------------------------------------------
# Where uploaded artifact bytes are stored (created if missing).
ARTIFACT_DIR=./data/artifacts
# Where per-task worker log chunks are appended (LOG_DIR/<task_id>.log).
LOG_DIR=./data/logs
# Directory served as static files at / (dashboard team's build output).
DASHBOARD_DIR=./dashboard

# --- Secrets ----------------------------------------------------------------
# 32-byte key as 64 hex chars. Generate:  openssl rand -hex 32
# Used for AES-256-GCM encryption of per-project secrets. Changing it
# invalidates previously stored secrets — back it up.
DATA_ENCRYPTION_KEY=

# --- Host bootstrap ----------------------------------------------------------
# Optional. When set, POST /v1/hosts/register accepts
# `Authorization: Bearer <PROVISIONING_TOKEN>` with no agent account,
# for hands-off first-boot provisioning. When unset (or when the token
# does not match), registration requires an agent token carrying the
# `deploy` permission. Generate:  openssl rand -hex 32
PROVISIONING_TOKEN=

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_AGENT_PER_MIN=120
RATE_LIMIT_HOST_PER_MIN=600

# --- Misc --------------------------------------------------------------------
PG_POOL_MAX=10
LOG_LEVEL=info

# --- Cloudflare DNS (optional, Phase 5) --------------------------------------
# When ALL three are set, POST /v1/domains creates a proxied CNAME
# <hostname> -> PUBLIC_INGRESS_HOSTNAME in the given zone. When any is
# unset, domains are stored as metadata only (status 'dns_pending').
# The token should be scoped to "Zone / DNS / Edit" on CLOUDFLARE_ZONE_ID.
# NOTE: this system never stores host IPs, so A-records pointing at a host
# are intentionally unsupported — use a tunnel/reverse-proxy as the ingress.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
PUBLIC_INGRESS_HOSTNAME=
