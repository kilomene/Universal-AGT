# --- Database ---------------------------------------------------------------
# Postgres connection string. Works with local Postgres or Supabase
# (use the Supabase "connection string" / transaction pooler URI).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/universal_agt

# --- Server -----------------------------------------------------------------
PORT=3000

# --- Storage ----------------------------------------------------------------
# Where uploaded artifact bytes are stored (created if missing).
ARTIFACT_DIR=./data/artifacts
# Where per-task worker log chunks are appended (LOG_DIR/<task_id>.log).
LOG_DIR=./data/logs
# Directory served as static files at / (dashboard team's build output).
DASHBOARD_DIR=./dashboard

# --- Secrets ----------------------------------------------------------------
# 32-byte key as 64 hex chars. Generate:  openssl rand -hex 32
# Used for AES-256-GCM encryption of per-project secrets. Changing it
# invalidates previously stored secrets — back it up.
DATA_ENCRYPTION_KEY=

# --- Host bootstrap ----------------------------------------------------------
# Optional. When set, POST /v1/hosts/register accepts
# `Authorization: Bearer <PROVISIONING_TOKEN>` with no agent account,
# for hands-off first-boot provisioning. When unset (or when the token
# does not match), registration requires an agent token carrying the
# `deploy` permission. Generate:  openssl rand -hex 32
PROVISIONING_TOKEN=

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_AGENT_PER_MIN=120
RATE_LIMIT_HOST_PER_MIN=600

# --- Host liveness ----------------------------------------------------------
# The stale-host sweeper marks hosts degraded/offline when their last
# heartbeat is older than these thresholds, emitting host.degraded /
# host.offline events. Hosts in operator-set `draining` are never touched.
HEARTBEAT_SWEEP_INTERVAL_S=30
HEARTBEAT_DEGRADED_AFTER_S=90
HEARTBEAT_OFFLINE_AFTER_S=300

# --- Misc --------------------------------------------------------------------
PG_POOL_MAX=10
LOG_LEVEL=info

# --- Cloudflare DNS (optional, Phase 5; tunnel mode Phase 7) -------------------
# When CLOUDFLARE_API_TOKEN + CLOUDFLARE_ZONE_ID and at least one ingress
# hostname are set, POST /v1/domains creates a proxied CNAME <hostname> ->
# the ingress target in the given zone. When unset, domains are stored as
# metadata only (status 'dns_pending').
# The token should be scoped to "Zone / DNS / Edit" on CLOUDFLARE_ZONE_ID.
# NOTE: this system never stores host IPs, so A-records pointing at a host
# are intentionally unsupported — use a tunnel/reverse-proxy as the ingress.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Direct mode (default): CNAME <hostname> -> PUBLIC_INGRESS_HOSTNAME.
# Your own ingress (reverse proxy / LB / tunnel you manage) in front of the
# host; reaching the host is your responsibility.
PUBLIC_INGRESS_HOSTNAME=
# Tunnel mode: CNAME <hostname> -> TUNNEL_INGRESS_HOSTNAME
# (e.g. <tunnel-id>.cfargotunnel.com). The host runs a worker-managed
# cloudflared tunnel (outbound-only). When set, new domains default to
# tunnel mode; POST /v1/domains {"ingress":"tunnel"} without this set is 422.
TUNNEL_INGRESS_HOSTNAME=
